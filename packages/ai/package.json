{
  "name": "@changepilot/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "generate:openai": "node --env-file=../../.env --import tsx src/providers/openai/run-first-generation.ts",
    "generate:tools:openai": "node --env-file=../../.env --import tsx src/providers/openai/run-first-tool-generation.ts",
    "generate:stream:openai": "node --env-file=../../.env --import tsx src/providers/openai/run-first-streaming-generation.ts",
    "generate:structured:openai": "node --env-file=../../.env --import tsx src/providers/openai/run-first-structured-generation.ts",
    "test": "vitest run",
    "test:integration:openai": "node --env-file=../../.env --import tsx src/providers/openai/run-streaming-integration-test.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "openai": "^7.4.0",
    "zod": "^4"
  }
}
